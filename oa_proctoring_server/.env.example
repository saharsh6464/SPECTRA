HOST=0.0.0.0
PORT=8000
DEBUG=false

# Comma-separated browser origins. Put your REAL frontend origin here.
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:///./data/proctoring.db

ENABLE_FACE_MATCH=true
ENABLE_LIVENESS=true
ENABLE_FACE_COUNT=true
ENABLE_DEVICE_DETECTION=true
ENABLE_HEAD_POSITION=true
ENABLE_VOICE_MONITORING=true
ENABLE_OCCUPANT_COUNT=true
ENABLE_POSTURE=true
ENABLE_TYPING_WRITING=true

FACE_MATCH_THRESHOLD=0.40
HEAD_YAW_THRESHOLD=15
HEAD_PITCH_THRESHOLD=15

# CoreML first, then CPU. Remove CoreML if your installed ONNX runtime lacks it.
ONNX_PROVIDERS=CoreMLExecutionProvider,CPUExecutionProvider

MAX_IMAGE_MB=10
MAX_AUDIO_MB=10

# Optional API protection. Leave empty during local development.
API_KEY=

PUBLIC_API_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:5173

SUPABASE_POLL_INTERVAL_SECONDS=10
SUPABASE_POLL_BATCH_SIZE=100
